# Database (local SQLite; production PostgreSQL URL uses postgresql+asyncpg://)
DATABASE_URL=sqlite+aiosqlite:///./data/dnd.db
# Production: postgresql+asyncpg://doupe:doupe@localhost:5432/doupedraka
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
LOAD_TEST_ENABLED=false

# Telegram Bot
BOT_TOKEN=your_telegram_bot_token_here
BOT_API_TOKEN=your_api_token_for_bot_auth
# Public HTTPS URL of the React Mini App (menu button / Web App launcher)
MINI_APP_URL=https://your-mini-app.example

# OpenRouter / LLM
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openai/gpt-4o-mini
# ollama | nvidia | groq | cerebras | auto | fallback
LLM_PROVIDER=fallback
# Used when LLM_PROVIDER=auto (or to extend a single primary provider). Skips entries without API keys.
LLM_PROVIDER_CHAIN=nvidia,groq,cerebras,ollama
LLM_READ_TIMEOUT_S=120
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama3-8b-instruct
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
CEREBRAS_API_KEY=
CEREBRAS_MODEL=llama3.1-8b
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
# How long to wait for the local model before the offline narrator takes over.
# 180 seconds is deliberately generous: an 8B model on CPU often needs 30-90s.
OLLAMA_TIMEOUT_S=180
# Legacy names are still honoured - MODEL_PROVIDER / MODEL_NAME /
# OLLAMA_BASE_URL - but the canonical names above win when both are set.

# CORS (comma-separated explicit origins; set the deployed Mini App origin)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Per-IP request limits
AUTH_RATE_LIMIT=10/minute
ACTION_RATE_LIMIT=30/minute

# Admin API (X-Admin-Token header) — stats, economy top-up
ADMIN_API_KEY=
