# Docker Compose secrets and service configuration.
#   copy .env.docker.example .env.docker
# Fill in values before: docker compose up -d
#
# Compose substitutes ${POSTGRES_PASSWORD} from this file (or a root `.env`).

POSTGRES_USER=doupe
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=doupedraka
DATABASE_URL=postgresql+asyncpg://doupe:change-me-strong-password@postgres:5432/doupedraka

BOT_TOKEN=your_telegram_bot_token_here
BOT_API_TOKEN=your_api_token_for_bot_auth
MINI_APP_URL=https://your-mini-app.example

ADMIN_API_KEY=change-me-admin-token

LLM_PROVIDER=auto
LLM_PROVIDER_CHAIN=nvidia,groq,cerebras,ollama
LLM_READ_TIMEOUT_S=120
NVIDIA_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:7b

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_BOOTSTRAP=none

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AUTH_RATE_LIMIT=30/minute
ACTION_RATE_LIMIT=30/minute
